rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions: allows any authenticated user (Google Auth, Phone, or Anonymous Auth)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Live Queue Entries
    match /queue_entries/{entryId} {
      allow read, write: if isAuthenticated();
      allow delete: if false;
    }

    // Doctor Day Slot Configurations
    match /doctor_day_slots/{slotId} {
      allow read, write: if isAuthenticated();
    }

    // Atomic Queue Token Counters
    match /queue_counters/{counterId} {
      allow read, write: if isAuthenticated();
    }

    // Patient Medical History
    match /patientMedicalHistory/{historyId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Doctor-to-Doctor and External Referrals
    match /referrals/{referralId} {
      allow read, write: if isAuthenticated();
    }

    // Condition Records / Cases
    match /condition_records/{recordId} {
      allow read, write: if isAuthenticated();
    }

    // Prescriptions
    match /prescriptions/{prescriptionId} {
      allow read, write: if isAuthenticated();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read, write: if isAuthenticated();
    }

    // Broadcast Notices
    match /broadcast_notices/{noticeId} {
      allow read, write: if isAuthenticated();
    }

    // Patients
    match /patients/{patientId} {
      allow read, write: if isAuthenticated();
    }

    // Default catch-all for clinical database collections
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
